{
  "name": "Daily Follow Repair",
  "description": "Repairs broken follow records, normalizes follow emails and IDs, and removes duplicate follow relationships each day. Old-user recovery is disabled for scheduled runs so users are not repeatedly auto-followed after they choose to unfollow.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_follow_repair",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "repairAndRecoverFollows",
            "args": {
              "full": true,
              "dry_run": false,
              "recover_old_users": false,
              "recovery_cap": 50
            }
          },
          "then": "end"
        }
      }
    ]
  }
}