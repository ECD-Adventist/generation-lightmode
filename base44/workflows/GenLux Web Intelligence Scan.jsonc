{
  "name": "GenLux Web Intelligence Scan",
  "description": "Runs a deep public-web scan every 15 minutes for monitored GenLux campaign terms and delivers in-app alerts.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "genlux_web_intelligence_scan",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_public_web": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scanGenLuxWeb",
            "args": {
              "keyword_limit": 1
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Deep-scan public web",
            "description": "Scan one rotating GenLux term"
          }
        }
      }
    ]
  }
}