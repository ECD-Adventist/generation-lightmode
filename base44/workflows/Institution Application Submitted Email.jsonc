{
  "name": "Institution Application Submitted Email",
  "description": "Emails admins when a new institution dashboard application is submitted.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"pending\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "InstitutionApplication"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "institution_application_submitted_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyInstitutionApplicationSubmitted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}