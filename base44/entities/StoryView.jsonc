{
  "name": "StoryView",
  "type": "object",
  "properties": {
    "story_id": {
      "type": "string"
    },
    "viewer_email": {
      "type": "string"
    }
  },
  "required": [
    "story_id",
    "viewer_email"
  ],
  "rls": {
    "create": {
      "data.viewer_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.viewer_email": "{{user.email}}"
        },
        {
          "in": {
            "data.story_id": {
              "$entity": "Story",
              "params": {
                "user_email": "{{user.email}}"
              }
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}