{
  "name": "GlowGroupMessage",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "user_email",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "in": {
            "group_id": {
              "$entity": "GlowGroupMember",
              "params": {
                "user_email": "{{user.email}}"
              }
            }
          }
        },
        {
          "in": {
            "group_id": {
              "$entity": "GlowGroup",
              "params": {
                "leader_email": "{{user.email}}"
              }
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "in": {
            "group_id": {
              "$entity": "GlowGroupMember",
              "params": {
                "user_email": "{{user.email}}"
              }
            }
          }
        },
        {
          "in": {
            "group_id": {
              "$entity": "GlowGroup",
              "params": {
                "leader_email": "{{user.email}}"
              }
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}