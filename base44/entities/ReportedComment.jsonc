{
  "name": "ReportedComment",
  "type": "object",
  "properties": {
    "comment_id": {
      "type": "string"
    },
    "reporter_email": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "resolved",
        "dismissed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "comment_id",
    "reporter_email",
    "reason"
  ],
  "rls": {
    "create": {
      "data.reporter_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "ecd_officer"
          }
        },
        {
          "user_condition": {
            "role": "union_officer"
          }
        },
        {
          "user_condition": {
            "role": "conference_field_officer"
          }
        },
        {
          "user_condition": {
            "role": "church_officer"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}