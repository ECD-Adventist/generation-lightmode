{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "missionary",
        "GlowGroup Leader",
        "moderator",
        "church_admin",
        "church_officer",
        "conference_field_admin",
        "conference_field_officer",
        "union_admin",
        "union_officer",
        "country_admin",
        "ecd_admin",
        "ecd_officer",
        "admin",
        "super_admin"
      ],
      "default": "user"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active",
      "description": "Account status \u2014 suspended users cannot post, like, or comment."
    },
    "suspended_reason": {
      "type": "string"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspended_by": {
      "type": "string"
    },
    "username": {
      "type": "string",
      "description": "Display handle, e.g. abbeywambua"
    },
    "profile_picture": {
      "type": "string",
      "description": "URL of uploaded profile photo"
    },
    "bio": {
      "type": "string",
      "description": "Short bio text"
    },
    "cover_image": {
      "type": "string",
      "description": "URL for profile cover/banner image"
    },
    "location": {
      "type": "string",
      "description": "Optional location text"
    },
    "xp_points": {
      "type": "number",
      "default": 0
    },
    "badge": {
      "type": "string",
      "description": "Earned badge label"
    },
    "display_name": {
      "type": "string",
      "description": "Legacy display name shown throughout the app. Prefer username when set."
    },
    "profile_picture_url": {
      "type": "string",
      "description": "Legacy profile photo URL. Kept for backwards compatibility."
    },
    "cover_picture_url": {
      "type": "string",
      "description": "Legacy cover photo URL. Kept for backwards compatibility."
    },
    "country": {
      "type": "string",
      "description": "Canonical country selected by the user or confirmed by an administrator. Empty only until location completion; never a city, phone code, flag, or inferred location.",
