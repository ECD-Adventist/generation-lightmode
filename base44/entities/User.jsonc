{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "missionary",
        "GlowGroup Leader",
        "moderator",
        "church_admin",
        "conference_field_admin",
        "union_admin",
        "country_admin",
        "ecd_admin",
        "admin",
        "super_admin"
      ],
      "default": "user"
    },
    "privacy_consent_given": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has accepted the privacy and communication consent"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "prefer_not_to_say"
      ],
      "description": "User's gender"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "User's date of birth (used to calculate age)"
    },
    "bio": {
      "type": "string",
      "description": "Short user bio"
    },
    "country": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "User's phone number"
    },
    "glow_score": {
      "type": "number",
      "default": 0
    },
    "profile_picture_url": {
      "type": "string"
    },
    "cover_picture_url": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "territory_name": {
      "type": "string",
      "description": "Name of the administrative territory this admin manages"
    },
    "territory_level": {
      "type": "string",
      "description": "Administrative level of the territory"
    },
    "territory_countries": {
      "type": "string",
      "description": "Comma-separated list of countries in this admin's territory"
    },
    "territory_map_url": {
      "type": "string",
      "description": "URL of the uploaded territory map image"
    },
    "territory_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Approval status of this admin's territory configuration"
    }
  },
  "required": []
}