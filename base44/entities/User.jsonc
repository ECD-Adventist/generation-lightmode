{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "missionary",
        "GlowGroup Leader",
        "moderator",
        "church_admin",
        "conference_field_admin",
        "union_admin",
        "country_admin",
        "ecd_admin",
        "admin",
        "super_admin"
      ],
      "default": "user"
    },
    "privacy_consent_given": {
      "type": "boolean",
      "default": false
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "prefer_not_to_say"
      ]
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "bio": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "description": "User's city or town"
    },
    "address": {
      "type": "string",
      "description": "User's street address"
    },
    "postal_code": {
      "type": "string",
      "description": "User's postal / zip code"
    },
    "phone": {
      "type": "string"
    },
    "glow_score": {
      "type": "number",
      "default": 0
    },
    "profile_picture_url": {
      "type": "string"
    },
    "cover_picture_url": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "territory_name": {
      "type": "string"
    },
    "territory_level": {
      "type": "string"
    },
    "territory_countries": {
      "type": "string"
    },
    "territory_map_url": {
      "type": "string"
    },
    "territory_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": []
}