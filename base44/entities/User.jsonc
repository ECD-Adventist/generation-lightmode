{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "missionary",
        "GlowGroup Leader",
        "moderator",
        "church_admin",
        "church_officer",
        "conference_field_admin",
        "conference_field_officer",
        "union_admin",
        "union_officer",
        "country_admin",
        "ecd_admin",
        "ecd_officer",
        "admin",
        "super_admin"
      ],
      "default": "user"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active",
      "description": "Account status \u2014 suspended users cannot post, like, or comment."
    },
    "suspended_reason": {
      "type": "string"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspended_by": {
      "type": "string"
    },
    "username": {
      "type": "string",
      "description": "Display handle, e.g. abbeywambua"
    },
    "profile_picture": {
      "type": "string",
      "description": "URL of uploaded profile photo"
    },
    "bio": {
      "type": "string",
      "description": "Short bio text"
    },
    "cover_image": {
      "type": "string",
      "description": "URL for profile cover/banner image"
    },
    "location": {
      "type": "string",
      "description": "Optional location text"
    },
    "xp_points": {
      "type": "number",
      "default": 0
    },
    "badge": {
      "type": "string",
      "description": "Earned badge label"
    },
    "display_name": {
      "type": "string",
      "description": "Legacy display name shown throughout the app. Prefer username when set."
    },
    "profile_picture_url": {
      "type": "string",
      "description": "Legacy profile photo URL. Kept for backwards compatibility."
    },
    "cover_picture_url": {
      "type": "string",
      "description": "Legacy cover photo URL. Kept for backwards compatibility."
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "gender": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "social_links": {
      "type": "string"
    },
    "territory_name": {
      "type": "string"
    },
    "glow_score": {
      "type": "number",
      "default": 0
    },
    "quiz_score": {
      "type": "number",
      "default": 0,
      "description": "Best cumulative Faith Quiz XP used for the champions leaderboard."
    },
    "quiz_level": {
      "type": "number",
      "default": 1,
      "description": "Highest Faith Quiz level unlocked for this user."
    },
    "quiz_stars": {
      "type": "string",
      "description": "JSON map of Faith Quiz level number to stars earned (0-3)."
    },
    "faith_streak_count": {
      "type": "number",
      "default": 0
    },
    "daily_checkin_streak": {
      "type": "number",
      "default": 0
    },
    "streak_count": {
      "type": "number",
      "default": 0
    },
    "pledge_signed": {
      "type": "boolean",
      "default": false
    },
    "pledge_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "privacy_consent_given": {
      "type": "boolean",
      "default": false
    },
    "notify_likes": {
      "type": "boolean",
      "default": true
    },
    "notify_follows": {
      "type": "boolean",
      "default": true
    },
    "notify_comments": {
      "type": "boolean",
      "default": true
    },
    "notify_messages": {
      "type": "boolean",
      "default": true
    },
    "light_booster_opt_in": {
      "type": "boolean",
      "default": false
    },
    "light_booster_approved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": []
}