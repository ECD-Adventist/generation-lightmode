{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "missionary",
        "GlowGroup Leader",
        "moderator",
        "church_admin",
        "conference_field_admin",
        "union_admin",
        "country_admin",
        "ecd_admin",
        "admin",
        "super_admin"
      ],
      "default": "user"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active",
      "description": "Account status \u2014 suspended users cannot post, like, or comment."
    },
    "suspended_reason": {
      "type": "string",
      "description": "Reason logged when a user was suspended."
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when a user was suspended."
    },
    "suspended_by": {
      "type": "string",
      "description": "Email of the admin who suspended the user."
    },
    "display_name": {
      "type": "string",
      "description": "User-editable display name shown throughout the app. Falls back to full_name when empty."
    },
    "social_links": {
      "type": "string",
      "description": "JSON string of social media profile links such as Facebook, Instagram, YouTube, TikTok, LinkedIn, X, WhatsApp."
    },
    "light_booster_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "If true, the user has consented to be part of the Light Boosters pool for automatic community encouragement likes."
    },
    "light_booster_approved": {
      "type": "boolean",
      "default": false,
      "description": "Admin approval flag allowing this opted-in user to be used for Light Booster bonus likes."
    }
  },
  "required": [
    "suspended_reason",
    "suspended_at",
    "suspended_by"
  ]
}