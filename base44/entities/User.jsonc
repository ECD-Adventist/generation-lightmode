    "provisional_country": {
      "type": "string",
      "description": "Strong-evidence country candidate awaiting administrator confirmation."
    },
    "assignment_status": {
      "type": "string",
      "enum": [
        "unassigned",
        "provisional",
        "confirmed"
      ],
      "default": "unassigned"
    },
    "assignment_source": {
      "type": "string",
      "enum": [
        "registration",
        "profile_update",
        "admin_assignment",
        "legacy_profile",
        "verified_provisional",
        "manual_import"
      ]
    },
    "assignment_confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "city": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "gender": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "social_links": {
      "type": "string"
    },
    "territory_name": {
      "type": "string"
    },
    "territory_level": {
      "type": "string",
      "description": "Territory scope level: ecd, country, union, conference_field, or church."
    },
    "territory_countries": {
      "type": "string",
      "description": "Comma-separated list of country names this leader/officer covers."
    },
    "territory_regions": {
      "type": "string",
      "description": "JSON map of country name to selected regions. Empty region list means the entire country."
    },
    "territory_map_url": {
      "type": "string",
      "description": "Optional uploaded territory map image URL."
    },
    "territory_extraction_notes": {
      "type": "string"
    },
    "territory_status": {
      "type": "string",
      "description": "Territory confirmation status: not_submitted, pending_review, approved, or rejected."
    },
    "glow_score": {
      "type": "number",
      "default": 0
    },
    "quiz_score": {
      "type": "number",
      "default": 0,
      "description": "Best cumulative Faith Quiz XP used for the champions leaderboard."
    },
    "quiz_level": {
      "type": "number",
      "default": 1,
      "description": "Highest Faith Quiz level unlocked for this user."
    },
    "quiz_stars": {
      "type": "string",
      "description": "JSON map of Faith Quiz level number to stars earned (0-3)."
    },
    "faith_streak_count": {
      "type": "number",
      "default": 0
    },
    "daily_checkin_streak": {
      "type": "number",
      "default": 0
    },
    "streak_count": {
      "type": "number",
      "default": 0
    },
    "pledge_signed": {
      "type": "boolean",
      "default": false
    },
    "pledge_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "privacy_consent_given": {
      "type": "boolean",
      "default": false
    },
    "notify_likes": {
      "type": "boolean",
      "default": true
    },
    "followers_count": {
      "type": "number",
      "description": "Cached number of Follow rows with following_id = this user. Maintained by manageFollow; backfilled by getConnections."
    },
    "following_count": {
      "type": "number",
      "description": "Cached number of Follow rows with follower_id = this user. Maintained by manageFollow; backfilled by getConnections."
    },
    "notify_follows": {
      "type": "boolean",
      "default": true
    },
    "notify_comments": {
      "type": "boolean",
      "default": true
    },
    "notify_messages": {
      "type": "boolean",
      "default": true
    },
    "light_booster_opt_in": {
      "type": "boolean",
      "default": false
    },
    "light_booster_approved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": []
}