{
  "name": "DevotionEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "day_number": {
      "type": "number"
    },
    "verse": {
      "type": "string"
    },
    "reflection": {
      "type": "string"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "date_string": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "plan_id",
    "day_number"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}