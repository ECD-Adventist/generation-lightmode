{
  "name": "GlowDrop",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "verse": {
      "type": "string"
    },
    "reflection": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "approved"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "If true, the drop is hidden from public feeds but not deleted. Admins can unhide."
    },
    "hidden_reason": {
      "type": "string",
      "description": "Reason recorded by admin when hiding a drop"
    },
    "moderation_note": {
      "type": "string",
      "description": "Internal admin note about moderation decisions"
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "description": "If true, this drop is pinned to the top of the public feed (for leader announcements). Only admins/super_admins can pin."
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "bonus_likes_count": {
      "type": "number",
      "default": 0,
      "description": "Temporary launch boost: number of automatic hourly bonus likes added to this drop. Stops at 24."
    },
    "bonus_likes_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Temporary launch boost flag. New user-created drops can receive 1 automatic bonus like per hour until 24."
    },
    "bonus_likes_last_applied_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last automatic bonus like was applied."
    },
    "category": {
      "type": "string"
    },
    "hashtags": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}",
      "user_condition": {
        "role": {
          "$ne": "guest"
        }
      }
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}