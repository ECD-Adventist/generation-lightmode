{
  "name": "GlowDrop",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the account that authored this drop."
    },
    "author_name": {
      "type": "string",
      "description": "Snapshot display name captured when the drop was created."
    },
    "author_username": {
      "type": "string",
      "description": "Snapshot username/handle captured when the drop was created."
    },
    "author_avatar": {
      "type": "string",
      "description": "Snapshot profile picture URL captured when the drop was created."
    },
    "verse": {
      "type": "string"
    },
    "reflection": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "media_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "approved"
    },
    "hidden": {
      "type": "boolean",
      "default": false
    },
    "hidden_reason": {
      "type": "string"
    },
    "is_flagged": {
      "type": "boolean",
      "default": false
    },
    "moderation_note": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "bonus_likes_count": {
      "type": "number",
      "default": 0
    },
    "bonus_likes_enabled": {
      "type": "boolean",
      "default": false
    },
    "bonus_likes_last_applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string"
    },
    "hashtags": {
      "type": "string"
    },
    "reposts_count": {
      "type": "number",
      "default": 0
    },
    "original_drop_id": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}