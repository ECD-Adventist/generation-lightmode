{
  "name": "GlowDrop",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "verse": {
      "type": "string"
    },
    "reflection": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "approved"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "If true, the drop is hidden from public feeds but not deleted. Admins can unhide."
    },
    "hidden_reason": {
      "type": "string",
      "description": "Reason recorded by admin when hiding a drop"
    },
    "moderation_note": {
      "type": "string",
      "description": "Internal admin note about moderation decisions"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string"
    },
    "hashtags": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "description": "If true, this drop is pinned to the top of the public feed. Reserved for admin/super_admin use to highlight key leader announcements."
    },
    "pinned_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the drop was pinned. Used to order multiple pinned posts (most recently pinned first)."
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}