{
  "name": "GlowDrop",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "verse": {
      "type": "string"
    },
    "reflection": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string"
    },
    "hashtags": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}