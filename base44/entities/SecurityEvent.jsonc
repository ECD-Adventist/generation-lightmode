{
  "name": "SecurityEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "maxLength": 80
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "user_id": {
      "type": "string",
      "maxLength": 64
    },
    "ip_address": {
      "type": "string",
      "maxLength": 64
    },
    "resource": {
      "type": "string",
      "maxLength": 160
    },
    "action": {
      "type": "string",
      "maxLength": 100
    },
    "status_code": {
      "type": "number",
      "minimum": 100,
      "maximum": 599
    },
    "request_count": {
      "type": "number",
      "minimum": 0
    },
    "details": {
      "type": "string",
      "maxLength": 1000
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_type",
    "severity",
    "occurred_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}