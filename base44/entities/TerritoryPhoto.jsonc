{
  "name": "TerritoryPhoto",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "territory": {
      "type": "string",
      "description": "Country or territory this photo belongs to"
    },
    "event_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "photo_url",
    "territory"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "church_admin"
          }
        },
        {
          "user_condition": {
            "role": "conference_field_admin"
          }
        },
        {
          "user_condition": {
            "role": "union_admin"
          }
        },
        {
          "user_condition": {
            "role": "country_admin"
          }
        },
        {
          "user_condition": {
            "role": "ecd_admin"
          }
        },
        {
          "user_condition": {
            "role": "GlowGroup Leader"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}