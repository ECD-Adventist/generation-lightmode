{
  "name": "GlowGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "leader_email": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "profile_picture_url": {
      "type": "string",
      "description": "Group profile/avatar image URL"
    },
    "cover_picture_url": {
      "type": "string",
      "description": "Group cover/banner image URL"
    },
    "welcome_message": {
      "type": "string",
      "description": "Pinned greeting shown to new members"
    },
    "privacy": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public",
      "description": "Public groups are discoverable; private groups require leader approval and don't appear in open search"
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated tags/focus areas e.g. 'prayer, youth, worship'"
    }
  },
  "required": [
    "name",
    "country",
    "leader_email"
  ],
  "rls": {
    "create": {
      "data.leader_email": "{{user.email}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.leader_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.leader_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}