{
  "name": "GlowGroupEventRSVP",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": [
        "going",
        "maybe",
        "cant_go"
      ]
    }
  },
  "required": [
    "event_id",
    "user_email",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.event_id": {
            "$entity": "GlowGroupEvent",
            "params": {
              "$or": [
                {
                  "in": {
                    "data.group_id": {
                      "$entity": "GlowGroupMember",
                      "params": {
                        "user_email": "{{user.email}}"
                      }
                    }
                  }
                },
                {
                  "in": {
                    "data.group_id": {
                      "$entity": "GlowGroup",
                      "params": {
                        "leader_email": "{{user.email}}"
                      }
                    }
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "super_admin"
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}