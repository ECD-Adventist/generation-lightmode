{
  "name": "GlowDropComment",
  "type": "object",
  "properties": {
    "drop_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "drop_id",
    "user_email",
    "content"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}