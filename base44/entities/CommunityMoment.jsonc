{
  "name": "CommunityMoment",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "status",
        "prayer"
      ],
      "default": "status"
    },
    "content": {
      "type": "string"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "content"
  ]
}