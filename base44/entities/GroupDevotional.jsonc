{
  "name": "GroupDevotional",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "title",
    "content",
    "author_email"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "$or": [
            {
              "in": {
                "data.group_id": {
                  "$entity": "GlowGroupMember",
                  "params": {
                    "user_email": "{{user.email}}"
                  }
                }
              }
            },
            {
              "in": {
                "data.group_id": {
                  "$entity": "GlowGroup",
                  "params": {
                    "leader_email": "{{user.email}}"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "read": true,
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}