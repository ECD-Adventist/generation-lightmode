{
  "name": "DigitalContent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "content_type": {
      "type": "string",
      "enum": [
        "video",
        "poster",
        "animation"
      ]
    },
    "language": {
      "type": "string",
      "maxLength": 60
    },
    "drive_link": {
      "type": "string",
      "description": "Google Drive share link pasted by the admin"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this content unlocks for users"
    },
    "download_count": {
      "type": "number",
      "default": 0
    },
    "share_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "content_type",
    "language",
    "drive_link",
    "scheduled_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "ecd_admin"
          }
        },
        {
          "user_condition": {
            "role": "country_admin"
          }
        },
        {
          "user_condition": {
            "role": "union_admin"
          }
        },
        {
          "user_condition": {
            "role": "conference_field_admin"
          }
        },
        {
          "user_condition": {
            "role": "church_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "ecd_admin"
          }
        },
        {
          "user_condition": {
            "role": "country_admin"
          }
        },
        {
          "user_condition": {
            "role": "union_admin"
          }
        },
        {
          "user_condition": {
            "role": "conference_field_admin"
          }
        },
        {
          "user_condition": {
            "role": "church_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "ecd_admin"
          }
        },
        {
          "user_condition": {
            "role": "country_admin"
          }
        },
        {
          "user_condition": {
            "role": "union_admin"
          }
        },
        {
          "user_condition": {
            "role": "conference_field_admin"
          }
        },
        {
          "user_condition": {
            "role": "church_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "ecd_admin"
          }
        },
        {
          "user_condition": {
            "role": "country_admin"
          }
        },
        {
          "user_condition": {
            "role": "union_admin"
          }
        },
        {
          "user_condition": {
            "role": "conference_field_admin"
          }
        },
        {
          "user_condition": {
            "role": "church_admin"
          }
        }
      ]
    }
  }
}