{
  "name": "AdminPermission",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The admin role this permission row applies to"
    },
    "tab_id": {
      "type": "string",
      "description": "The Admin Center tab identifier"
    },
    "can_view": {
      "type": "boolean",
      "default": false,
      "description": "Whether this role can view the tab"
    },
    "can_edit": {
      "type": "boolean",
      "default": false,
      "description": "Whether this role can edit/modify within the tab"
    }
  },
  "required": [
    "role",
    "tab_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}