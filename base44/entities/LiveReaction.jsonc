{
  "name": "LiveReaction",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "reaction": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "user_email",
    "reaction"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": false,
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}