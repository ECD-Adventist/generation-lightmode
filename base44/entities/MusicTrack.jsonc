{
  "name": "MusicTrack",
  "type": "object",
  "properties": {
    "drive_file_id": {
      "type": "string",
      "description": "Google Drive file id of the source audio file."
    },
    "name": {
      "type": "string",
      "description": "Display name of the track."
    },
    "file_url": {
      "type": "string",
      "description": "Permanent playable URL after the Drive file was copied into app storage."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "drive_file_id",
    "file_url"
  ],
  "rls": {
    "create": false,
    "read": true,
    "update": false,
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}