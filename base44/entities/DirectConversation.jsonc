{
  "name": "DirectConversation",
  "type": "object",
  "properties": {
    "participant_a_email": {
      "type": "string"
    },
    "participant_b_email": {
      "type": "string"
    },
    "last_message": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "participant_a_email",
    "participant_b_email"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.participant_a_email": "{{user.email}}"
        },
        {
          "data.participant_b_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.participant_a_email": "{{user.email}}"
        },
        {
          "data.participant_b_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}