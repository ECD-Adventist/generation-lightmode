{
  "name": "LiveSession",
  "type": "object",
  "properties": {
    "broadcaster_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "broadcaster_email",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.broadcaster_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.broadcaster_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.broadcaster_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}