{
  "name": "GroupSession",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "host_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "group_id",
    "host_email",
    "title",
    "scheduled_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.host_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "in": {
            "data.group_id": {
              "$entity": "GlowGroup",
              "params": {
                "leader_email": "{{user.email}}"
              }
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "in": {
            "data.group_id": {
              "$entity": "GlowGroupMember",
              "params": {
                "user_email": "{{user.email}}"
              }
            }
          }
        },
        {
          "in": {
            "data.group_id": {
              "$entity": "GlowGroup",
              "params": {
                "leader_email": "{{user.email}}"
              }
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.host_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.host_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}