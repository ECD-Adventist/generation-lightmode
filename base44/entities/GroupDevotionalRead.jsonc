{
  "name": "GroupDevotionalRead",
  "type": "object",
  "properties": {
    "devotional_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    }
  },
  "required": [
    "devotional_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "in": {
            "data.devotional_id": {
              "$entity": "GroupDevotional",
              "params": {
                "group_id": {
                  "$entity": "GlowGroupMember",
                  "params": {
                    "user_email": "{{user.email}}"
                  }
                }
              }
            }
          }
        },
        {
          "in": {
            "data.devotional_id": {
              "$entity": "GroupDevotional",
              "params": {
                "group_id": {
                  "$entity": "GlowGroup",
                  "params": {
                    "leader_email": "{{user.email}}"
                  }
                }
              }
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}