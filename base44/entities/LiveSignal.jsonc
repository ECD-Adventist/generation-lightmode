{
  "name": "LiveSignal",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "signal_type": {
      "type": "string",
      "enum": [
        "offer",
        "answer",
        "candidate"
      ]
    },
    "payload": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "sender_email",
    "recipient_email",
    "signal_type",
    "payload"
  ],
  "rls": {
    "create": {
      "data.sender_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        }
      ]
    },
    "update": false,
    "delete": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        }
      ]
    }
  }
}