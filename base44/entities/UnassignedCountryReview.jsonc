{
  "name": "UnassignedCountryReview",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "maxLength": 64
    },
    "user_email": {
      "type": "string",
      "maxLength": 320
    },
    "display_name": {
      "type": "string",
      "maxLength": 200
    },
    "stored_country": {
      "type": "string",
      "maxLength": 120
    },
    "stored_city": {
      "type": "string",
      "maxLength": 120
    },
    "missing_country": {
      "type": "boolean"
    },
    "missing_city": {
      "type": "boolean"
    },
    "registration_evidence": {
      "type": "string",
      "maxLength": 1000,
      "description": "Saved profile location evidence; not proof of physical signup origin."
    },
    "evidence_origin": {
      "type": "string",
      "enum": [
        "saved_profile",
        "none"
      ]
    },
    "review_reason": {
      "type": "string",
      "maxLength": 500
    },
    "suggested_country": {
      "type": "string",
      "maxLength": 120
    },
    "suggestion_source": {
      "type": "string",
      "maxLength": 60
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "none"
      ],
      "default": "none"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "assigned",
        "dismissed"
      ],
      "default": "pending_review"
    },
    "notify_pending": {
      "type": "boolean",
      "default": true
    },
    "notified_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_country": {
      "type": "string"
    },
    "previous_country": {
      "type": "string"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}