{
  "name": "GenLuxMention",
  "type": "object",
  "properties": {
    "keyword_id": {
      "type": "string",
      "maxLength": 64
    },
    "keyword": {
      "type": "string",
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "maxLength": 500
    },
    "url": {
      "type": "string",
      "maxLength": 2048
    },
    "domain": {
      "type": "string",
      "maxLength": 300
    },
    "source_type": {
      "type": "string",
      "enum": [
        "news",
        "blog",
        "church",
        "publication",
        "video",
        "web"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "discovered_at": {
      "type": "string",
      "format": "date-time"
    },
    "country": {
      "type": "string",
      "maxLength": 100
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "Positive",
        "Neutral",
        "Negative"
      ]
    },
    "topic": {
      "type": "string",
      "maxLength": 200
    },
    "potential_reach": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Very High"
      ]
    },
    "excerpt": {
      "type": "string",
      "maxLength": 1000
    },
    "fingerprint": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "keyword_id",
    "keyword",
    "title",
    "url",
    "discovered_at",
    "fingerprint"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "ecd_admin"
          }
        },
        {
          "user_condition": {
            "role": "country_admin"
          }
        },
        {
          "user_condition": {
            "role": "union_admin"
          }
        },
        {
          "user_condition": {
            "role": "conference_field_admin"
          }
        },
        {
          "user_condition": {
            "role": "church_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "ecd_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "ecd_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "ecd_admin"
          }
        }
      ]
    }
  }
}