{
  "name": "PrayerComment",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "request_id",
    "user_email",
    "content"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": null,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}