{
  "name": "ChallengeSubmission",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "submission_url": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "points_awarded": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "challenge_id",
    "user_email",
    "submission_url"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}",
      "user_condition": {
        "role": {
          "$ne": "guest"
        }
      }
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}