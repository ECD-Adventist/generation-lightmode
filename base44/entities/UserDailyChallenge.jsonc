{
  "name": "UserDailyChallenge",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "date_string": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "date_string",
    "challenge_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}