{
  "name": "UserDailyChallenge",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "date_string": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "date_string",
    "challenge_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}