{
  "name": "TerritoryPhotoReaction",
  "type": "object",
  "properties": {
    "photo_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "reaction": {
      "type": "string",
      "enum": [
        "\ud83c\udf1f",
        "\ud83d\udd25",
        "\ud83d\ude4f",
        "\ud83d\udc9b",
        "\u26a1"
      ],
      "description": "Glow reaction emoji"
    }
  },
  "required": [
    "photo_id",
    "user_email",
    "reaction"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}