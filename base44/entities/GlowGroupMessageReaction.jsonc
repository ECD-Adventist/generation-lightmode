{
  "name": "GlowGroupMessageReaction",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "emoji": {
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "message_id",
    "user_email",
    "emoji"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "in": {
            "group_id": {
              "$entity": "GlowGroupMember",
              "params": {
                "user_email": "{{user.email}}"
              }
            }
          }
        },
        {
          "in": {
            "group_id": {
              "$entity": "GlowGroup",
              "params": {
                "leader_email": "{{user.email}}"
              }
            }
          }
        }
      ]
    },
    "read": true,
    "update": false,
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    }
  }
}