{
  "name": "PrayerRequest",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Health",
        "Family",
        "Finance",
        "Guidance",
        "Other"
      ],
      "default": "Other"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "answered": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email",
    "content"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}