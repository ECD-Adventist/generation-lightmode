{
  "name": "InstitutionPage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Institution or organization name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly unique identifier"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the account that owns this page"
    },
    "banner_url": {
      "type": "string",
      "description": "Cover/banner image URL"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo/avatar image URL"
    },
    "mission_statement": {
      "type": "string",
      "description": "Mission or about text"
    },
    "category": {
      "type": "string",
      "enum": [
        "church",
        "ministry",
        "nonprofit",
        "school",
        "community",
        "other"
      ],
      "default": "ministry"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "organization_map_url": {
      "type": "string",
      "description": "Public organization structure/map image URL"
    },
    "extracted_territories": {
      "type": "string",
      "description": "JSON string of territories extracted from the org map"
    },
    "social_links": {
      "type": "string",
      "description": "JSON string of social media links such as Facebook, Instagram, YouTube, X, LinkedIn"
    },
    "setup_completed": {
      "type": "boolean",
      "default": false,
      "description": "True when the approved institution has completed the guided setup wizard"
    },
    "setup_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "team_members": {
      "type": "string",
      "description": "JSON string of team member objects"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "followers_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "owner_email"
  ],
  "rls": {
    "create": false,
    "read": true,
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}