{
  "name": "InstitutionApplication",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "institution_name": {
      "type": "string"
    },
    "institution_type": {
      "type": "string",
      "enum": [
        "church",
        "school",
        "ministry",
        "organization",
        "other"
      ]
    },
    "country": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "procedures_description": {
      "type": "string"
    },
    "commitment_description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "organization_map_url": {
      "type": "string",
      "description": "Image URL of the organization structure/map"
    },
    "extracted_territories": {
      "type": "string",
      "description": "JSON string of territories extracted from the org map"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "revoked"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "institution_name",
    "institution_type",
    "country",
    "contact_person",
    "contact_email",
    "procedures_description",
    "commitment_description"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}