{
  "name": "Story",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "text_content": {
      "type": "string"
    },
    "story_type": {
      "type": "string",
      "enum": [
        "image",
        "status"
      ],
      "default": "status"
    },
    "background_theme": {
      "type": "string",
      "enum": [
        "ocean",
        "violet",
        "sunrise",
        "midnight"
      ],
      "default": "ocean"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "expires_at"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}