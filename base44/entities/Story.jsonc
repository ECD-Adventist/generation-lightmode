{
  "name": "Story",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "text_content": {
      "type": "string"
    },
    "story_type": {
      "type": "string",
      "enum": [
        "image",
        "status"
      ],
      "default": "status"
    },
    "background_theme": {
      "type": "string",
      "enum": [
        "ocean",
        "violet",
        "sunrise",
        "midnight",
        "emerald",
        "rose"
      ],
      "default": "ocean"
    },
    "audio_url": {
      "type": "string",
      "description": "URL of the music track attached to this status."
    },
    "audio_title": {
      "type": "string",
      "description": "Display name of the attached music track."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "view_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "expires_at"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}