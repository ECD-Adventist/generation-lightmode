{
  "name": "Repost",
  "type": "object",
  "properties": {
    "original_post_id": {
      "type": "string",
      "maxLength": 64
    },
    "reposter_user_id": {
      "type": "string",
      "maxLength": 64
    },
    "reposter_email": {
      "type": "string",
      "maxLength": 320
    },
    "reposter_name": {
      "type": "string",
      "maxLength": 160
    },
    "caption": {
      "type": "string",
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "original_post_id",
    "reposter_user_id",
    "created_at"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}