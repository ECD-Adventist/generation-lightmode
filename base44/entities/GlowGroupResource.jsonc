{
  "name": "GlowGroupResource",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "pdf",
        "link",
        "study_guide",
        "video",
        "document",
        "image"
      ],
      "default": "link"
    },
    "category": {
      "type": "string",
      "enum": [
        "Study Guides",
        "Devotionals",
        "Sermons",
        "Worship",
        "Prayer",
        "Training",
        "General"
      ],
      "default": "General"
    },
    "url": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "added_by": {
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.added_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.added_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.added_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.added_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}